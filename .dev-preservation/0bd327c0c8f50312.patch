+  it("requires nondecreasing creation, start, finish, and removal times", () => {
+    expect(() =>
+      parseOciRunReceipt(receiptInput({ createdAt: "2026-08-11T16:00:02.001Z" })),
+    ).toThrow(/timestamps must be monotonic/u);
