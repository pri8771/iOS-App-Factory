+
+function isCiPath(path: string): boolean {
+  return (
+    /^\.github\/workflows\/[^/]+\.ya?ml$/u.test(path) ||
+    path === "fastlane/Fastfile" ||
+    path === "bitrise.yml" ||
+    path === ".circleci/config.yml" ||
+    path === "azure-pipelines.yml" ||
+    path === "Jenkinsfile" ||
+    path === ".gitlab-ci.yml"
