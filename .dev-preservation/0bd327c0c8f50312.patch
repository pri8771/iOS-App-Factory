+      }
+
+      const headRow = this.database
+        .prepare(`${PROJECT_PLAN_SELECT} WHERE plan_id = ?`)
+        .get(draft.planId) as ProjectPlanRow | undefined;
+      const head = headRow === undefined ? null : decodeProjectPlan(headRow);
