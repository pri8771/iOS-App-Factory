+});
+
+describe("ProjectPhaseActualsV1", () => {
+  const actuals = {
+    phase: "build",
+    attemptCount: 3,
+    activeAttemptCount: 1,
+    blockerCount: 1,
+    succeededAttemptCount: 1,
+    firstAttemptAt: T0,
+    lastActivityAt: T2,
+    lastSucceededAt: T1,
