+          correlationKey: "github-pr-77",
+          resource: resourceFor(),
+          detail: new TextEncoder().encode('{"safe":"send"}\n'),
+        };
+      },
+      async reconcile() {
+        return {
+          kind: "observed",
+          correlationKey: "github-pr-77",
+          resource: resourceFor(),
