+    private func addParticipant(_ entry: RoomCatalogProviderEntry, to roomId: RoomID, rooms: RoomsModel) {
+        Task {
+            guard let key = entry.roomProviderKey ?? (try? RoomProvider(entry.provider.rawValue)) else { return }
