+      throw new OciRunnerError("OCI removed closure has no proven execution start");
+    }
+    if (
+      postStart.inspectionStatus === "terminal" &&
+      sha256Digest(postStartArtifact.bytes) !== sha256Digest(terminalArtifact.bytes)
