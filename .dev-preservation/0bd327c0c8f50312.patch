+  }),
+});
+
+export const AttemptFenceClaimedEventV1Schema = z.strictObject({
+  ...EventEnvelopeV1Shape,
+  type: z.literal("attempt.fence-claimed"),
+  data: z.strictObject({
+    previousFence: NonNegativeSafeIntegerSchema,
