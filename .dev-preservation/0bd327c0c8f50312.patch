+    schemaVersion: SUPERVISED_RUN_CANCELLATION_SCHEMA_VERSION,
+    runKey: release.runKey,
+    attemptId: release.attemptId,
+    fence: release.fence,
+    identityDigest: release.identityDigest,
+    requestedAt: release.releasedAt,
+  });
