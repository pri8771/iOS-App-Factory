+        "- factory.rule.authority.import=AGENTS.md",
+        `* Factory-Rule authority.digest=${digest}`,
+        `factory-rule: authority.digest=${digest}`,
+      ],
+    );
+    const scan = scanExistingProject({ repositoryRoot });
