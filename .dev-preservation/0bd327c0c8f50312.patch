+  const deadline = Date.now() + timeoutMs;
+  while (!predicate()) {
+    if (Date.now() >= deadline) throw new Error("Timed out waiting for the pump loop");
+    await new Promise((resolve) => setTimeout(resolve, 5));
+  }
+}
