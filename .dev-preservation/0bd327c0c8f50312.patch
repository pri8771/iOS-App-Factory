new file mode 100644
index 0000000..0226a07
--- /dev/null
+++ b/packages/contracts/src/v1/phase.ts
@@ -0,0 +1,416 @@
+import { z } from "zod";
+
+import { CommandOriginV1Schema } from "./command.js";
+import { TypedGateNameV1Schema } from "./lifecycle.js";
+import {
+  CommandIdSchema,
+  IsoInstantSchema,
+  NonNegativeSafeIntegerSchema,
+  PositiveSafeIntegerSchema,
+  SchemaVersionV1Schema,
+} from "./primitives.js";
+import { ProjectKindV1Schema } from "./project.js";
+
+/**
+ * Studio Phase 4: user-editable Phase Presets (`docs/roadmap/STUDIO_PHASES.md` Phase 4,
+ * `docs/architecture/0004-studio-mac-app.md` decision 5). A `PhaseDefinitionV1` is one editable
+ * step of work — a solo/panel/debate/chat collaboration among a bounded cast, constrained by
+ * machine-enforced standard rules and prompted operator rules, producing typed outputs written
+ * into the repository's own `docs/` tree. A `PhasePresetV1` bundles an ordered list of phases —
+ * the renamed carrier for the V3 "Situation" concept. This file defines the wire shapes only;
+ * nothing here executes a phase (that is the separate planner task) and nothing here resolves
+ * `rules.standard[]` against the compiled policy source (that external fact-check is a daemon-side
+ * port — see `phase-command-runtime.ts` — because `packages/kernel` may import from
+ * `@app-factory/contracts` only, per `dependency-cruiser.config.cjs`'s
+ * `kernel-imports-contracts-only` rule, and `@app-factory/policy-corpus` is not contracts).
+ *
+ * Every participant in a phase's cast is `readOnly: true`: a Phase Preset is a planning/review
+ * surface over `source-readonly` inputs, never a source-code writer. Actual code changes happen
+ * through `task.submit`/`task.run` attempts, a separate mechanism.
+ */
+
+const PHASE_ID_PATTERN = /^[a-z][a-z0-9-]{0,63}$/;
+const PHASE_PRESET_ID_PATTERN = /^[a-z][a-z0-9-]{0,63}(?:\.[a-z0-9]{1,16}){0,6}$/;
+const PHASE_PROVIDER_PATTERN = /^[a-z][a-z0-9-]{0,63}$/;
+const PHASE_PERSONA_PATTERN = /^[a-z][a-z0-9-]{0,63}$/;
+
+export const MAX_PHASE_PARTICIPANTS_V1 = 8 as const;
+export const MAX_PHASE_INPUTS_V1 = 5 as const;
+export const MAX_PHASE_STANDARD_RULES_V1 = 20 as const;
+export const MAX_PHASE_YOUR_RULES_V1 = 20 as const;
+export const MAX_PHASE_REQUIRED_OUTPUT_STATEMENTS_V1 = 20 as const;
+export const MAX_PHASE_ACCEPTANCE_CHECKS_V1 = 20 as const;
+export const MAX_PHASE_OUTPUTS_V1 = 10 as const;
+export const MAX_PHASE_GATES_V1 = TypedGateNameV1Schema.options.length;
+export const MAX_PRESET_PHASES_V1 = 50 as const;
+export const MAX_PHASE_TIMEOUT_SECONDS_V1 = 24 * 60 * 60;
+export const MAX_PHASE_ESTIMATE_MINUTES_V1 = 24 * 60;
+
+export const PhaseIdSchema = z
+  .string()
+  .regex(PHASE_ID_PATTERN, "Expected a stable lowercase phase key")
+  .brand<"PhaseId">();
+export type PhaseId = z.infer<typeof PhaseIdSchema>;
+
+export const PhasePresetIdSchema = z
+  .string()
+  .min(1)
+  .max(96)
+  .regex(PHASE_PRESET_ID_PATTERN, "Expected a stable lowercase preset key, optionally versioned")
+  .brand<"PhasePresetId">();
+export type PhasePresetId = z.infer<typeof PhasePresetIdSchema>;
+
+export const PhaseProviderSchema = z
+  .string()
+  .regex(PHASE_PROVIDER_PATTERN, "Expected a lowercase provider key")
+  .brand<"PhaseProvider">();
+export type PhaseProvider = z.infer<typeof PhaseProviderSchema>;
+
+export const PhasePersonaSchema = z
+  .string()
+  .regex(PHASE_PERSONA_PATTERN, "Expected a lowercase persona key")
+  .brand<"PhasePersona">();
+export type PhasePersona = z.infer<typeof PhasePersonaSchema>;
+
+export const PhaseModeV1Schema = z.enum(["solo", "panel", "debate", "chat"]);
+export type PhaseModeV1 = z.infer<typeof PhaseModeV1Schema>;
+
+export const PhaseInputKindV1Schema = z.enum([
+  "docs",
+  "source-readonly",
+  "evidence",
+  "issues",
+  "web",
+]);
+export type PhaseInputKindV1 = z.infer<typeof PhaseInputKindV1Schema>;
+
+/** One agent seat in a phase's cast. Always read-only; see the module doc comment. */
+export const PhaseParticipantV1Schema = z.strictObject({
+  provider: PhaseProviderSchema,
+  persona: PhasePersonaSchema.nullable(),
+  readOnly: z.literal(true),
+});
+export type PhaseParticipantV1 = z.infer<typeof PhaseParticipantV1Schema>;
+
+/** Identifies a cast member by the same `(provider, persona)` pair a participant carries. */
+export const PhaseRoleRefV1Schema = z.strictObject({
+  provider: PhaseProviderSchema,
+  persona: PhasePersonaSchema.nullable(),
+});
+export type PhaseRoleRefV1 = z.infer<typeof PhaseRoleRefV1Schema>;
+
+function phaseRoleKey(role: Readonly<{ provider: string; persona: string | null }>): string {
+  return `${role.provider} ${role.persona ?? ""}`;
+}
+
+export const PhaseCastV1Schema = z
+  .strictObject({
+    participants: z.array(PhaseParticipantV1Schema).max(MAX_PHASE_PARTICIPANTS_V1),
+    coordinator: PhaseRoleRefV1Schema.nullable(),
+    grader: PhaseRoleRefV1Schema.nullable(),
+  })
+  .superRefine((cast, context) => {
+    const keys = cast.participants.map(phaseRoleKey);
+    if (new Set(keys).size !== keys.length) {
+      context.addIssue({
+        code: "custom",
+        path: ["participants"],
+        message: "cast participants must be unique by (provider, persona)",
+      });
+    }
+  });
+export type PhaseCastV1 = z.infer<typeof PhaseCastV1Schema>;
+
+export const PhaseRulesV1Schema = z
+  .strictObject({
+    /**
+     * `ruleId` references into the compiled policy source
+     * (`docs/policy/ios-app-factory-policy-source.v1.json`), machine-enforced. Resolving these
+     * against the real rule catalog is a daemon-side port, not this schema — see the module doc
+     * comment.
+     */
+    standard: z
+      .array(z.string().min(1).max(128))
+      .max(MAX_PHASE_STANDARD_RULES_V1)
+      .refine(
+        (values) => new Set(values).size === values.length,
+        "rules.standard entries must be unique",
+      ),
+    /** Free-text operator rules; never machine-enforced, only prompted to the cast. */
+    yours: z.array(z.string().min(1).max(2_000)).max(MAX_PHASE_YOUR_RULES_V1),
+    requiredOutput: z
+      .array(z.string().min(1).max(2_000))
+      .max(MAX_PHASE_REQUIRED_OUTPUT_STATEMENTS_V1),
+    acceptanceChecks: z.array(z.string().min(1).max(2_000)).max(MAX_PHASE_ACCEPTANCE_CHECKS_V1),
+  })
+  .superRefine((rules, context) => {
+    if (new Set(rules.requiredOutput).size !== rules.requiredOutput.length) {
+      context.addIssue({
+        code: "custom",
+        path: ["requiredOutput"],
+        message: "rules.requiredOutput entries must be unique",
+      });
+    }
+    if (new Set(rules.acceptanceChecks).size !== rules.acceptanceChecks.length) {
+      context.addIssue({
+        code: "custom",
+        path: ["acceptanceChecks"],
+        message: "rules.acceptanceChecks entries must be unique",
+      });
+    }
+  });
+export type PhaseRulesV1 = z.infer<typeof PhaseRulesV1Schema>;
+
+/** A typed output artifact this phase writes. `path` is always repo-relative under `docs/`. */
+export const PhaseOutputV1Schema = z.strictObject({
+  path: z
+    .string()
+    .min(1)
+    .max(1_024)
+    .refine(
+      (value) => value.startsWith("docs/") && !value.includes(".."),
+      "output path must be repo-relative under docs/",
+    ),
+  /** Repo-relative path to the JSON Schema this output must validate against, when one applies. */
+  schema: z.string().min(1).max(1_024).nullable(),
+});
+export type PhaseOutputV1 = z.infer<typeof PhaseOutputV1Schema>;
+
+export const PhaseBudgetV1Schema = z
+  .strictObject({
+    estimateMinutes: z.number().int().min(1).max(MAX_PHASE_ESTIMATE_MINUTES_V1).nullable(),
+    timeoutSeconds: z.number().int().min(1).max(MAX_PHASE_TIMEOUT_SECONDS_V1),
+  })
+  .superRefine((budget, context) => {
+    if (budget.estimateMinutes !== null && budget.estimateMinutes * 60 > budget.timeoutSeconds) {
+      context.addIssue({
+        code: "custom",
+        path: ["estimateMinutes"],
+        message: "estimateMinutes cannot exceed timeoutSeconds",
+      });
+    }
+  });
+export type PhaseBudgetV1 = z.infer<typeof PhaseBudgetV1Schema>;
+
+export const MAX_PHASE_PROMPT_LENGTH_V1 = 10_000 as const;
+export const MAX_PHASE_TOPIC_SCOPE_LENGTH_V1 = 2_000 as const;
+export const MAX_PHASE_TURN_POLICY_ROUNDS_V1 = 12 as const;
+
+/**
+ * Parameterizes the stage engine's four existing modes (Architecture decision 8) rather than
+ * introducing a graph engine: `maxRounds` bounds how many polling rounds `buildPhaseInstructionV1`
+ * / the phase-run executor will drive before stopping regardless of mode; `perParticipantTurnCap`
+ * additionally bounds how many of those rounds any single cast member may speak in, when set.
+ */
+export const PhaseTurnPolicyV1Schema = z.strictObject({
+  maxRounds: z.number().int().min(1).max(MAX_PHASE_TURN_POLICY_ROUNDS_V1),
+  perParticipantTurnCap: z.number().int().min(1).max(MAX_PHASE_TURN_POLICY_ROUNDS_V1).nullable(),
+});
+export type PhaseTurnPolicyV1 = z.infer<typeof PhaseTurnPolicyV1Schema>;
+
+/** Enforced over KNOWN usage only (Architecture decision 6/8): a contribution whose provider
+ *  reported no usage does not silently count as zero against this cap, and the phase run's
+ *  outcome notes partial enforcement whenever that happened. */
+export const PhaseTokenBudgetV1Schema = z.strictObject({
+  maxTotalTokens: PositiveSafeIntegerSchema,
+});
+export type PhaseTokenBudgetV1 = z.infer<typeof PhaseTokenBudgetV1Schema>;
+
+const PhaseDefinitionDraftV1Shape = {
+  phaseId: PhaseIdSchema,
+  name: z.string().min(1).max(200),
+  purpose: z.string().min(1).max(2_000),
+  mode: PhaseModeV1Schema,
+  cast: PhaseCastV1Schema,
+  inputs: z.array(PhaseInputKindV1Schema).max(MAX_PHASE_INPUTS_V1),
+  rules: PhaseRulesV1Schema,
+  outputs: z.array(PhaseOutputV1Schema).max(MAX_PHASE_OUTPUTS_V1),
+  /** Typed lifecycle gates (`lifecycle.ts`) this phase's completion is evidence for, if any. */
+  gates: z.array(TypedGateNameV1Schema).max(MAX_PHASE_GATES_V1),
+  budget: PhaseBudgetV1Schema,
+  /** An operator briefing PREPENDED to the synthesized instruction (never a replacement) --
+   *  Architecture decision 8. */
+  prompt: z.string().min(1).max(MAX_PHASE_PROMPT_LENGTH_V1).nullable().default(null),
+  /** Free-text scope prompted to the cast; never machine-enforced, same status as `rules.yours`. */
+  topicScope: z.string().min(1).max(MAX_PHASE_TOPIC_SCOPE_LENGTH_V1).nullable().default(null),
+  turnPolicy: PhaseTurnPolicyV1Schema.nullable().default(null),
+  tokenBudget: PhaseTokenBudgetV1Schema.nullable().default(null),
+};
+
+function refinePhaseDefinitionDraft(
+  phase: Readonly<{
+    mode: PhaseModeV1;
+    cast: PhaseCastV1;
+    inputs: readonly PhaseInputKindV1[];
+    outputs: readonly PhaseOutputV1[];
+    gates: readonly string[];
+  }>,
+  context: z.RefinementCtx,
+): void {
+  if (new Set(phase.inputs).size !== phase.inputs.length) {
+    context.addIssue({ code: "custom", path: ["inputs"], message: "inputs must be unique" });
+  }
+  if (new Set(phase.gates).size !== phase.gates.length) {
+    context.addIssue({ code: "custom", path: ["gates"], message: "gates must be unique" });
+  }
+  const outputPaths = phase.outputs.map((output) => output.path);
+  if (new Set(outputPaths).size !== outputPaths.length) {
+    context.addIssue({
+      code: "custom",
+      path: ["outputs"],
+      message: "output paths must be unique",
+    });
+  }
+  if (phase.mode === "solo" && phase.cast.participants.length !== 1) {
+    context.addIssue({
+      code: "custom",
+      path: ["cast", "participants"],
+      message: "mode solo requires exactly one cast participant",
+    });
+  }
+  if (phase.cast.grader !== null) {
+    const graderKey = phaseRoleKey(phase.cast.grader);
+    if (phase.cast.participants.some((participant) => phaseRoleKey(participant) === graderKey)) {
+      context.addIssue({
+        code: "custom",
+        path: ["cast", "grader"],
+        message: "grader must differ from every cast participant",
+      });
+    }
+  }
+}
+
+export const PhaseDefinitionDraftV1Schema = z
+  .strictObject(PhaseDefinitionDraftV1Shape)
+  .superRefine(refinePhaseDefinitionDraft);
+export type PhaseDefinitionDraftV1 = z.infer<typeof PhaseDefinitionDraftV1Schema>;
+
+/**
+ * The durable, revisioned phase definition. `revision` starts at 0 on creation and advances by
+ * exactly one per accepted upsert; the kernel keeps every revision as an append-only history row,
+ * so this is always the head. Mirrors `ProjectMilestoneV1`'s draft/durable split exactly.
+ */
+export const PhaseDefinitionV1Schema = z
+  .strictObject({
+    schemaVersion: SchemaVersionV1Schema,
+    ...PhaseDefinitionDraftV1Shape,
+    revision: NonNegativeSafeIntegerSchema,
+    createdAt: IsoInstantSchema,
+    updatedAt: IsoInstantSchema,
+  })
+  .superRefine((phase, context) => {
+    refinePhaseDefinitionDraft(phase, context);
+    if (phase.updatedAt < phase.createdAt) {
+      context.addIssue({
+        code: "custom",
+        path: ["updatedAt"],
+        message: "updatedAt precedes createdAt",
+      });
+    }
+    if (phase.revision === 0 && phase.updatedAt !== phase.createdAt) {
+      context.addIssue({
+        code: "custom",
+        path: ["updatedAt"],
+        message: "revision 0 must carry its creation timestamp",
+      });
+    }
+  });
+export type PhaseDefinitionV1 = z.infer<typeof PhaseDefinitionV1Schema>;
+
+export const PhaseDefinitionUpsertV1Schema = z.strictObject({
+  phase: PhaseDefinitionDraftV1Schema,
+  expectedRevision: NonNegativeSafeIntegerSchema.nullable(),
+});
+export type PhaseDefinitionUpsertV1 = z.infer<typeof PhaseDefinitionUpsertV1Schema>;
+
+export const PhaseDefinitionUpsertCommandV1Schema = z.strictObject({
+  schemaVersion: SchemaVersionV1Schema,
+  commandId: CommandIdSchema,
+  issuedAt: IsoInstantSchema,
+  origin: CommandOriginV1Schema,
+  kind: z.literal("phase.upsert"),
+  upsert: PhaseDefinitionUpsertV1Schema,
+});
+export type PhaseDefinitionUpsertCommandV1 = z.infer<typeof PhaseDefinitionUpsertCommandV1Schema>;
+
+const PhasePresetDraftV1Shape = {
+  presetId: PhasePresetIdSchema,
+  name: z.string().min(1).max(200),
+  /** Ordered; the sequence a Studio operator runs the preset's phases in. */
+  phases: z.array(PhaseDefinitionV1Schema).min(1).max(MAX_PRESET_PHASES_V1),
+  /** `null` applies to every project kind; otherwise the preset is scoped to the listed kinds. */
+  appliesTo: z.array(ProjectKindV1Schema).nullable(),
+};
+
+function refinePhasePresetDraft(
+  preset: Readonly<{
+    phases: readonly Readonly<{ phaseId: string }>[];
+    appliesTo: readonly string[] | null;
+  }>,
+  context: z.RefinementCtx,
+): void {
+  const phaseIds = preset.phases.map((phase) => phase.phaseId);
+  if (new Set(phaseIds).size !== phaseIds.length) {
+    context.addIssue({
+      code: "custom",
+      path: ["phases"],
+      message: "phase IDs must be unique within a preset",
+    });
+  }
+  if (preset.appliesTo !== null && new Set(preset.appliesTo).size !== preset.appliesTo.length) {
+    context.addIssue({
+      code: "custom",
+      path: ["appliesTo"],
+      message: "appliesTo entries must be unique",
+    });
+  }
+}
+
+export const PhasePresetDraftV1Schema = z
+  .strictObject(PhasePresetDraftV1Shape)
+  .superRefine(refinePhasePresetDraft);
+export type PhasePresetDraftV1 = z.infer<typeof PhasePresetDraftV1Schema>;
+
+/** The durable, revisioned phase preset. Mirrors `PhaseDefinitionV1`'s draft/durable split. */
+export const PhasePresetV1Schema = z
+  .strictObject({
+    schemaVersion: SchemaVersionV1Schema,
+    ...PhasePresetDraftV1Shape,
+    revision: NonNegativeSafeIntegerSchema,
+    createdAt: IsoInstantSchema,
+    updatedAt: IsoInstantSchema,
+  })
+  .superRefine((preset, context) => {
+    refinePhasePresetDraft(preset, context);
+    if (preset.updatedAt < preset.createdAt) {
+      context.addIssue({
+        code: "custom",
+        path: ["updatedAt"],
+        message: "updatedAt precedes createdAt",
+      });
+    }
+    if (preset.revision === 0 && preset.updatedAt !== preset.createdAt) {
+      context.addIssue({
+        code: "custom",
+        path: ["updatedAt"],
+        message: "revision 0 must carry its creation timestamp",
+      });
+    }
+  });
+export type PhasePresetV1 = z.infer<typeof PhasePresetV1Schema>;
+
+export const PhasePresetUpsertV1Schema = z.strictObject({
+  preset: PhasePresetDraftV1Schema,
+  expectedRevision: NonNegativeSafeIntegerSchema.nullable(),
+});
+export type PhasePresetUpsertV1 = z.infer<typeof PhasePresetUpsertV1Schema>;
+
+export const PhasePresetUpsertCommandV1Schema = z.strictObject({
+  schemaVersion: SchemaVersionV1Schema,
+  commandId: CommandIdSchema,
+  issuedAt: IsoInstantSchema,
+  origin: CommandOriginV1Schema,
+  kind: z.literal("preset.upsert"),
+  upsert: PhasePresetUpsertV1Schema,
+});
+export type PhasePresetUpsertCommandV1 = z.infer<typeof PhasePresetUpsertCommandV1Schema>;
diff --git a/packages/contracts/src/v1/portfolio-read-model.ts b/packages/contracts/src/v1/portfolio-read-model.ts
new file mode 100644
index 0000000..9a9258e
--- /dev/null
+++ b/packages/contracts/src/v1/portfolio-read-model.ts
@@ -0,0 +1,344 @@
+import { z } from "zod";
+
+import {
+  IsoInstantSchema,
+  NonNegativeSafeIntegerSchema,
+  ProjectIdSchema,
+  SchemaVersionV1Schema,
+  Sha256DigestSchema,
+  StableKeySchema,
+} from "./primitives.js";
+import { LegacyProjectLifecycleStageV1Schema } from "./project.js";
+
+export const MAX_PORTFOLIO_PROJECTS_V1 = 1_000 as const;
+
+export const PortfolioSourceAvailabilityV1Schema = z.enum(["available", "unavailable"]);
+export type PortfolioSourceAvailabilityV1 = z.infer<typeof PortfolioSourceAvailabilityV1Schema>;
+
+export const PortfolioHealthV1Schema = z.enum(["healthy", "attention", "blocked", "unknown"]);
+export type PortfolioHealthV1 = z.infer<typeof PortfolioHealthV1Schema>;
+
+export const PortfolioHealthReasonV1Schema = z.enum([
+  "unresolved-p0",
+  "delivery-blocker",
+  "unresolved-p1",
+  "jira-unavailable",
+  "github-unavailable",
+  "quality-unavailable",
+  "release-unavailable",
+  "analytics-stale",
+  "analytics-unavailable",
+]);
+export type PortfolioHealthReasonV1 = z.infer<typeof PortfolioHealthReasonV1Schema>;
+
+const NullableCountV1Schema = NonNegativeSafeIntegerSchema.nullable();
+
+export const PortfolioProjectSourceAvailabilityV1Schema = z.strictObject({
+  localExecution: z.literal("available"),
+  jira: PortfolioSourceAvailabilityV1Schema,
+  github: PortfolioSourceAvailabilityV1Schema,
+  quality: PortfolioSourceAvailabilityV1Schema,
+  release: PortfolioSourceAvailabilityV1Schema,
+  analytics: PortfolioSourceAvailabilityV1Schema,
+});
+export type PortfolioProjectSourceAvailabilityV1 = z.infer<
+  typeof PortfolioProjectSourceAvailabilityV1Schema
+>;
+
+function matchesAvailability(
+  availability: PortfolioSourceAvailabilityV1,
+  values: readonly (number | null)[],
+): boolean {
+  return availability === "available"
+    ? values.every((value) => value !== null)
+    : values.every((value) => value === null);
+}
+
+function expectedHealthReasons(
+  project: Readonly<{
+    blockerCount: number;
+    unresolvedP0: number | null;
+    unresolvedP1: number | null;
+    analyticsFreshness: "fresh" | "stale" | "unavailable";
+    sources: PortfolioProjectSourceAvailabilityV1;
+  }>,
+): PortfolioHealthReasonV1[] {
+  const reasons: PortfolioHealthReasonV1[] = [];
+  if ((project.unresolvedP0 ?? 0) > 0) reasons.push("unresolved-p0");
+  if (project.blockerCount > 0) reasons.push("delivery-blocker");
+  if ((project.unresolvedP1 ?? 0) > 0) reasons.push("unresolved-p1");
+  if (project.sources.jira === "unavailable") reasons.push("jira-unavailable");
+  if (project.sources.github === "unavailable") reasons.push("github-unavailable");
+  if (project.sources.quality === "unavailable") reasons.push("quality-unavailable");
+  if (project.sources.release === "unavailable") reasons.push("release-unavailable");
+  if (project.analyticsFreshness === "stale") reasons.push("analytics-stale");
+  if (project.sources.analytics === "unavailable") reasons.push("analytics-unavailable");
+  return reasons;
+}
+
+function expectedHealth(
+  project: Readonly<{
+    blockerCount: number;
+    unresolvedP0: number | null;
+    unresolvedP1: number | null;
+    analyticsFreshness: "fresh" | "stale" | "unavailable";
+    sources: PortfolioProjectSourceAvailabilityV1;
+  }>,
+): PortfolioHealthV1 {
+  if (project.blockerCount > 0 || (project.unresolvedP0 ?? 0) > 0) return "blocked";
+  if ((project.unresolvedP1 ?? 0) > 0 || project.analyticsFreshness === "stale") {
+    return "attention";
+  }
+  if (Object.values(project.sources).includes("unavailable")) return "unknown";
+  return "healthy";
+}
+
+export const PortfolioProjectReadModelV1Schema = z
+  .strictObject({
+    projectId: ProjectIdSchema,
+    slug: StableKeySchema,
+    displayName: z.string().min(1).max(200),
+    metadataSource: z.literal("task-derived"),
+    lifecycleStage: LegacyProjectLifecycleStageV1Schema.nullable(),
+    attemptCount: NonNegativeSafeIntegerSchema,
+    activeAttemptCount: NonNegativeSafeIntegerSchema,
+    blockerCount: NonNegativeSafeIntegerSchema,
+    lastActivityAt: IsoInstantSchema.nullable(),
+    lastDeliveryAt: IsoInstantSchema.nullable(),
+    openPullRequestCount: NullableCountV1Schema,
+    jiraTodoCount: NullableCountV1Schema,
+    jiraInProgressCount: NullableCountV1Schema,
+    unresolvedP0: NullableCountV1Schema,
+    unresolvedP1: NullableCountV1Schema,
+    releaseStage: z.string().min(1).max(100).nullable(),
+    analyticsFreshness: z.enum(["fresh", "stale", "unavailable"]),
+    sources: PortfolioProjectSourceAvailabilityV1Schema,
+    health: PortfolioHealthV1Schema,
+    healthReasons: z.array(PortfolioHealthReasonV1Schema).max(9),
+  })
+  .superRefine((project, context) => {
+    if (project.activeAttemptCount > project.attemptCount) {
+      context.addIssue({
+        code: "custom",
+        path: ["activeAttemptCount"],
+        message: "activeAttemptCount must not exceed attemptCount",
+      });
+    }
+    if (project.blockerCount > project.attemptCount) {
+      context.addIssue({
+        code: "custom",
+        path: ["blockerCount"],
+        message: "blockerCount must not exceed attemptCount",
+      });
+    }
+    if (!matchesAvailability(project.sources.github, [project.openPullRequestCount])) {
+      context.addIssue({
+        code: "custom",
+        path: ["openPullRequestCount"],
+        message: "GitHub counts must be null exactly when GitHub is unavailable",
+      });
+    }
+    if (
+      !matchesAvailability(project.sources.jira, [
+        project.jiraTodoCount,
+        project.jiraInProgressCount,
