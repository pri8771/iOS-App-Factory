+  assertGitHubOwnerBindingMatches(JSON.parse(JSON.stringify(binding)), {
+    owner,
+    ownerNodeId: binding.ownerNodeId,
+    credentialReference,
+    credentialOrigin: apiBaseUrl,
+  });
