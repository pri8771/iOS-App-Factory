+    {
+      name: "incomplete capture",
+      response: result(`${DOCKER_SERVER_IDENTITY}\n`, {
+        stdoutObservedBytes: Buffer.byteLength(`${DOCKER_SERVER_IDENTITY}\n`) + 1,
+      }),
