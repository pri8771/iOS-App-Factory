+      "ruleId": "rule.scope.declared-paths",
+      "statement": "Work happens only inside the task's declared scope, worktree, and repository. User changes and unrelated files are preserved; changed paths outside the declared scope are refused before commit. Product, shared-library, and central-rules changes are separate changes in their respective repositories with their own scope and evidence; a task may identify a required change in another repository but never silently makes it or pushes it merely because access is available.",
+      "enforcement": "broker",
+      "requiredCheck": "policy.changed-paths"
