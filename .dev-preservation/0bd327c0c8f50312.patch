+    schemaVersion: SUPERVISED_RUN_INTENT_SCHEMA_VERSION,
+    ...identityFields,
+    createdAt: parseTimestamp(value.createdAt, "createdAt"),
+    executable,
+    argv,
+    cwd,
+    environment,
+    stdin: parseStdin(value.stdin),
+    limits: parseLimits(value.limits),
+  };
