+              )
+              .join("\n");
+      const roster =
+        catalog.roster.length === 0
+          ? "no roster entries"
+          : catalog.roster
+              .map(
+                (entry) =>
+                  `${entry.roomId}\t${entry.kind}\t${String(entry.participants.length)} persona(s)${
+                    entry.participants.length === 0
