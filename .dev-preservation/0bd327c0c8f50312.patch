+  }
+
+  #nextAttempt(
+    current: ExecutionAttemptV1,
+    transition: SchedulerAttemptTransition,
+    occurredAt: IsoInstant,
+  ): ExecutionAttemptV1 {
+    const common = {
+      ...current,
+      state: transition.to,
+      revision: current.revision + 1,
+      updatedAt: occurredAt,
+      blocker: null,
+      outcome: null,
+      terminalAt: null,
+    } as const;
