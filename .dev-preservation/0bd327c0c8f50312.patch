+              lastActivityAt: T0,
+              lastSucceededAt: null,
+            },
+            {
+              phase: "build",
+              attemptCount: 1,
+              activeAttemptCount: 0,
+              blockerCount: 0,
+              succeededAttemptCount: 0,
+              firstAttemptAt: T0,
+              lastActivityAt: T0,
+              lastSucceededAt: null,
+            },
+          ],
+          lifecycle: [],
+        },
+      },
+    ],
+    [
+      "phase activity after generatedAt",
+      {
+        actuals: {
+          phases: [
+            {
+              phase: "build",
+              attemptCount: 1,
+              activeAttemptCount: 0,
+              blockerCount: 0,
+              succeededAttemptCount: 0,
+              firstAttemptAt: T0,
+              lastActivityAt: "2026-08-16T12:00:00.000Z",
+              lastSucceededAt: null,
