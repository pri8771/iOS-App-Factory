+import { describe, expect, it } from "vitest";
+
+import {
+  RoomCreateSpecV1Schema,
+  RoomFlavorV1Schema,
+  RoomGrantOutcomeV1Schema,
+  RoomUpdatePatchV1Schema,
+  RoomUpdateSpecV1Schema,
+  RoomV1Schema,
+} from "../src/index.js";
+
