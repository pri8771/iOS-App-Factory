+    ...overrides,
+  });
+  services.push(service);
+  const client = createCommandClient({
+    socketPath: service.socketPath,
+    authorization: AUTHORIZATION,
+    origin: "cli",
+  });
+  clients.push(client);
+  return { service, client, diagnostics };
