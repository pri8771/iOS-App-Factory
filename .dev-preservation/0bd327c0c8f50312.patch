+function fakeCharters(): RoomCharterProvider {
+  const observed: unknown[] = [];
+  return {
+    observe: (roomId, transcript) => {
+      observed.push({ roomId, count: transcript.length });
+    },
+    charterFor: (room, participant) => ({
+      roomCharter: `Charter for ${room.title}`,
