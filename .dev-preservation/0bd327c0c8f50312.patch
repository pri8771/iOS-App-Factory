+  exactKeys(
+    record,
+    [
+      "codexHome",
+      "executable",
+      "executableDigest",
+      "expectedCliVersion",
+      "mode",
+      "model",
+      "projectConfigurationFile",
+      "schemaVersion",
+    ],
+    undefined,
+    ["agentLimits", "siblingExecutables"],
+  );
+  if (record.schemaVersion !== 1 || record.mode !== "enrolled-codex-v1") {
+    configurationError("The local execution profile has an unsupported schema or mode.");
+  }
