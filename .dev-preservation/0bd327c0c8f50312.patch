+  it("requires each citation to carry a real URL", () => {
+    expect(() =>
+      SignalScoutFindingV1Schema.parse({
+        schemaVersion: 1,
+        headline: "Claim",
+        rationale: "Reasoning.",
+        confidence: "weak",
+        citations: [{ url: "not a url", title: "Source" }],
+      }),
+    ).toThrow();
+  });
