+    record,
+    [
+      "schemaVersion",
+      "additionalTrustBoundaryPathPrefixes",
+      "additionalTrustBoundarySegments",
+      "additionalPolicyMarkers",
+      "allowances",
+    ],
+    "Protected-path policy extension",
