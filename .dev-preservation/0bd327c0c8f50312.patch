+  const observedRepositories: GitHubOwnerBindingRepositoryV1[] = [];
+  enrolledRepositories.forEach((fullName, index) => {
+    const observed = parseObservedRepository(
+      data[`${REPOSITORY_ALIAS_PREFIX}${String(index)}`],
