+  public async execute(context: SchedulerExecutionContext) {
+    if (context.signal.aborted) throw abortedExecution();
+    await context.assertActive();
+    if (this.#delayMs > 0) await this.#wait(this.#delayMs, context.signal);
+    if (context.signal.aborted) throw abortedExecution();
+    await context.assertActive();
