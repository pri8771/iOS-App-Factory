+      context.addIssue({
+        code: "custom",
+        path: ["lineRange", "end"],
+        message: "lineRange.end must not precede lineRange.start",
+      });
+    }
+  });
+export type ProjectDocsSourceRefV1 = z.infer<typeof ProjectDocsSourceRefV1Schema>;
+
