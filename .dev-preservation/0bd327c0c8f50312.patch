+  .strictObject({
+    path: RelativePathSchema,
+    sha256: Sha256DigestSchema,
+    lineRange: z
+      .strictObject({ start: PositiveSafeIntegerSchema, end: PositiveSafeIntegerSchema })
+      .nullable(),
+  })
