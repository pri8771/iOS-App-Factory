+    value.process.exitCode === null
+      ? null
+      : parseBoundedInteger(value.process.exitCode, "process.exitCode", 0, 255);
+  const signal =
+    value.process.signal === null
+      ? null
+      : parseSingleLine(value.process.signal, "process.signal", 32);
