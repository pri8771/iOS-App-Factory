+    attemptId: string,
+    fence: number,
+    taskSpecDigest: Sha256Digest,
+    eventDigest: Sha256Digest,
+  ): boolean {
+    try {
+      const directory = safeChild(dirname(this.#paths.agentResultRoot), "reported-no-changes");
+      const path = safeChild(directory, `${eventDigest.replace(":", "-")}.json`);
