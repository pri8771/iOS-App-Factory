+          "tests",
+          "__tests__",
+          "uitests",
+          "unittests",
+          "integrationtests",
+          "snapshots",
+          "__snapshots__",
+          "testsupport",
+          "uitestsupport",
+          "testing",
+          "e2e",
+          "spec",
+          "specs",
+          "fixtures",
+          "__fixtures__",
+          "test-fixtures",
+          "test_fixtures",
+          "testfixtures",
+          "testkit",
+          "test-kit",
+          "testutils",
+          "test-utils",
+          "testhelpers",
+          "test-helpers",
+          "mocks",
+          "__mocks__",
