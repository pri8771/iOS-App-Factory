+  #now(): number {
+    const observed = Date.now();
+    if (!Number.isFinite(observed)) throw new Error("The replay cache clock is invalid.");
+    this.#lastObservedAtMs = Math.max(this.#lastObservedAtMs, observed);
+    return this.#lastObservedAtMs;
+  }
