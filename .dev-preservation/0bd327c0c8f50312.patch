+      throw new OciRunnerError("OCI running evidence changed container identity");
+    }
+    executionStartedAt = assertSameEvidenceExecution(
+      createdInspection,
+      running,
+      executionStartedAt,
+      "OCI running inspection",
+    );
+    artifacts.push(
+      evidenceArtifact(
+        prepared.paths.runningInspectionPath,
+        "running.inspect.json",
+        "application/json",
+      ),
+    );
+  }
