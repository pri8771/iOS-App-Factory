+
+type AdminCapture = Readonly<{
+  snapshot: GitAdminSnapshotV1;
+  files: readonly AdminFile[];
+}>;
+
+type SnapshotAndEntries = Readonly<{
+  snapshot: EnrollmentScanV1["before"];
+  entries: readonly ScanEntry[];
