+  const body: BindingBody = {
+    schemaVersion: GITHUB_OWNER_BINDING_SCHEMA_VERSION,
+    provider: "github",
+    viewerLogin,
+    viewerNodeId,
+    ownerLogin,
+    ownerNodeId,
+    ownerType,
+    enrolledRepositories,
+    observedRepositories,
+    credentialReference,
+    credentialOrigin: base.origin,
