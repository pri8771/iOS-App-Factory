+function request(
+  operation: CommandRequestV1["operation"],
+  id: string,
+  payload: unknown,
+  issuedAt = T0,
+): CommandRequestV1 {
+  return CommandRequestV1Schema.parse({
+    schemaVersion: 1,
+    commandId: id,
+    issuedAt,
+    origin: "cli",
+    operation,
+    payload,
