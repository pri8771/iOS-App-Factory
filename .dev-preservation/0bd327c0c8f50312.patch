+        result.messages.length === 0
+          ? "no messages"
+          : result.messages
+              .map((message) =>
+                message.kind === "system"
+                  ? `${String(message.sequence)}\t${message.occurredAt}\tsystem:${message.code}\t${message.body}`
+                  : `${String(message.sequence)}\t${message.occurredAt}\t${
