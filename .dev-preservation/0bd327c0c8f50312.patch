+  privateTmpfsPath: typeof OCI_PRIVATE_TMPFS_PATH;
+  networkMode: "none";
+  readOnlyRootFilesystem: true;
+  agentExecutable: string;
+  agentArguments: readonly string[];
+  environment: readonly Readonly<{ name: string; value: string }>[];
