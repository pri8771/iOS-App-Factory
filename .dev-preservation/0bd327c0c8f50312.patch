+    expect(LEGACY_PROJECT_LIFECYCLE_STAGE_MAP_V1).toEqual({
+      exploring: "idea",
+      planned: "idea",
+      building: "building",
+      qa: "qa",
+      "internal-testflight": "launch-prep",
+      released: "live",
+      paused: "frozen",
+      archived: "frozen",
+    });
+  });
+
+  it("is annotated as deprecated in the portable schema", () => {
