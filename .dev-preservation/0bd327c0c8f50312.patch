+    inspection,
+    {
+      stdout: stdoutBytes,
+      stderr: stderrBytes,
+      stdoutObservedBytes: stdout.observedByteLength,
+      stderrObservedBytes: stderr.observedByteLength,
+    },
+    prepared.intent.limits.outputBytesPerStream,
+    prepared.intent.limits.wallTimeMs,
+    requested,
+  );
