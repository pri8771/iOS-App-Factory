+          schemaVersion: 1,
+          eventId: EventIdSchema.parse(
+            this.#idFactory("step-state-event", {
+              attemptId: attempt.attemptId,
+              fence: storedLease.fence,
+              sequence,
+              stepKey: input.key,
+            }),
+          ),
+          attemptId: attempt.attemptId,
+          sequence,
+          occurredAt,
+          commandId: null,
+          causationEventId: lastEvent?.eventId ?? null,
+          fence: storedLease.fence,
+          type: "step.state-changed",
