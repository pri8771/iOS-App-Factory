+
+export type OciRunIntentV1 = Readonly<{
+  schemaVersion: typeof OCI_RUN_INTENT_SCHEMA_VERSION;
+  runKey: string;
+  attemptId: string;
+  runId: string;
+  fence: number;
+  createdAt: string;
