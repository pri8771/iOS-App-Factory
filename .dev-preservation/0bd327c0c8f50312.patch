+    executable,
+    executableDigest,
+    expectedCliVersion,
+    model,
+    codexHome,
+    runnerRoot,
+    outputSchemaPath,
+    environmentAllowlist,
+    environment,
+    readOnlyPaths,
+    permissionProfileName,
