+             ?, ?, ?, NULL,
+             ?, ?, ?, ?, NULL,
+             ?, 'owner@example.com', 'trusted.approval-service', ?, ?,
+             ?, '{}', 'single-use', NULL, ?,
+             ?, 'active', NULL, NULL, NULL, '{}'
+           )`,
+        )
+        .run(
+          "9c000000-0000-4000-8000-0000000000e1",
+          PROJECT_ID,
+          TASK_ID,
+          "9c000000-0000-4000-8000-0000000000ff",
+          PAYLOAD_DIGEST,
+          PLAN_DIGEST,
+          DIFF_DIGEST,
+          COMMIT,
+          POLICY_DIGEST,
+          T0,
+          ATTESTATION_DIGEST,
+          ATTESTATION_DIGEST,
+          T0,
+          EXPIRES,
