+    schemaVersion: SUPERVISED_RUN_INTENT_SCHEMA_VERSION,
+    runKey: input.runKey,
+    attemptId: input.attemptId,
+    fence: input.fence,
+    createdAt: input.createdAt,
+    executable: input.executable,
+    argv: [...(input.argv ?? [])],
+    cwd: input.cwd,
