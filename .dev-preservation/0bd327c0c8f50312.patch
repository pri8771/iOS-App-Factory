+  public async verifyImage(image: OciImageIdentityV1): Promise<void> {
+    if (image.imageId !== OCI_TEST_IMAGE_ID || image.reference !== OCI_TEST_IMAGE_REFERENCE) {
+      throw new Error("Unexpected OCI test image");
+    }
+  }
