+  const cached = caseInsensitiveVolumeCache.get(mirrorPath);
+  if (cached !== undefined) return cached;
+  const result = probeCaseInsensitiveVolume(mirrorPath);
+  caseInsensitiveVolumeCache.set(mirrorPath, result);
+  return result;
+}
