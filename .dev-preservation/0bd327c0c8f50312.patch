+  catalog: RoomParticipantsCatalogDigestInputV1 | RoomParticipantsCatalogV1,
+): RoomParticipantsCatalogDigestInputV1 {
+  return RoomParticipantsCatalogDigestInputV1Schema.parse({
+    schemaVersion: catalog.schemaVersion,
