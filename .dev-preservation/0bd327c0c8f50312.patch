+          return toAttemptSnapshot(
+            this.#repositories.transitionAttemptState({
+              leaseKey: storedLease.leaseKey,
+              ownerId: storedLease.ownerId,
+              observedAt: occurredAt,
+              expectedRevision: input.expectedRevision,
+              attempt: next,
+              event,
+            }),
