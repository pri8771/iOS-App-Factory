+        stats.isSymbolicLink() ||
+        !stats.isFile() ||
+        stats.nlink !== 1 ||
+        (stats.mode & 0o077) !== 0 ||
+        (typeof process.getuid === "function" && stats.uid !== process.getuid()) ||
+        stats.size > MAX_AGENT_RESULT_BYTES
