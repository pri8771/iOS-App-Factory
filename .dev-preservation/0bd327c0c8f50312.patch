+  const runningArtifact = parsedArtifact(
+    prepared.paths.runningInspectionPath,
+    "OCI running inspection",
+  );
+  const running =
+    runningArtifact === null
+      ? null
+      : parseInspectionArtifact(
+          runningArtifact.value,
+          prepared,
+          "running",
+          "OCI running inspection",
+        );
