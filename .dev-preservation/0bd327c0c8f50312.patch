+    // queued+running attempt, with no scheduler-side changes required.
+    expect(
+      repositories.attempts.listReconciliationCandidates({ limit: 10 }).map((a) => a.attemptId),
+    ).toEqual([retriedAttemptId]);
+    database.close();
+  });
