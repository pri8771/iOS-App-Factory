+  encoded = Buffer.from(
+    `${JSON.stringify(
+      failure(
+        requestId,
+        "protocol.response-too-large",
+        "The command response exceeded the configured byte limit.",
+      ),
+    )}\n`,
+    "utf8",
+  );
+  return encoded.byteLength <= maxResponseBytes ? encoded : undefined;
