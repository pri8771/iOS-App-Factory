+export type OciRunLimitsV1 = Readonly<{
+  cpuCount: number;
+  memoryBytes: number;
+  pidLimit: number;
+  outputBytesPerStream: number;
+  wallTimeMs: number;
+  stopGraceMs: number;
+  privateTmpfsBytes: number;
