+        "maxStdoutBytes",
+        "maxStderrBytes"
+      ],
+      "type": "object"
+    },
+    "runId": {
+      "$ref": "#/$defs/__schema0"
+    },
+    "schemaVersion": {
+      "const": 1,
+      "type": "number"
+    },
+    "stepId": {
+      "$ref": "#/$defs/__schema0"
