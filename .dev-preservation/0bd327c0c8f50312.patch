+      schemaVersion: 1,
+      ...boundIdentity(prepared),
+      containerId: quarantine.containerId,
+      quarantineDigest: persistedArtifactDigest(
+        artifactPaths(prepared).quarantine,
+        "OCI quarantine",
+      ),
+      requestedAt,
+    };
