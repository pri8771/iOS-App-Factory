+        schemaVersion: request.schemaVersion,
+        commandId: request.commandId,
+        issuedAt: request.issuedAt,
+        origin: request.origin,
+        operation: request.operation,
+        payload: request.payload,
+      }),
+    )
+    .digest("hex");
