+export function runBoundedGit(cwd: string, args: readonly string[]): Buffer {
+  const result = spawnSync(GIT, ["--no-pager", "--literal-pathspecs", "-C", cwd, ...args], {
+    cwd,
+    encoding: null,
+    env: {
