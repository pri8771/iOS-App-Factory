+    }
+
+    public init(presetId: PhasePresetId, name: String, phases: [PhaseDefinition], appliesTo: [ProjectKind]?,
+                revision: Int, createdAt: IsoInstant, updatedAt: IsoInstant) {
+        self.presetId = presetId
