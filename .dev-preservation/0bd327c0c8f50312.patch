+
+function swiftCodeSurface(content: string): string {
+  let result = "";
+  let index = 0;
+  let blockCommentDepth = 0;
+  let mode: "code" | "line-comment" | "block-comment" | "string" | "multiline-string" = "code";
+  while (index < content.length) {
+    const current = content[index] ?? "";
+    const next = content[index + 1] ?? "";
+    const triple = content.slice(index, index + 3) === '"""';
+    if (mode === "line-comment") {
+      if (current === "\n") {
+        mode = "code";
+        result += "\n";
+      } else result += " ";
+      index += 1;
+      continue;
+    }
+    if (mode === "block-comment") {
+      if (current === "/" && next === "*") {
+        blockCommentDepth += 1;
+        result += "  ";
+        index += 2;
+      } else if (current === "*" && next === "/") {
+        blockCommentDepth -= 1;
+        result += "  ";
+        index += 2;
+        if (blockCommentDepth === 0) mode = "code";
+      } else {
+        result += current === "\n" ? "\n" : " ";
+        index += 1;
+      }
+      continue;
+    }
+    if (mode === "string" || mode === "multiline-string") {
+      if (mode === "multiline-string" && triple) {
+        result += "   ";
+        index += 3;
+        mode = "code";
+      } else if (mode === "string" && current === "\\") {
+        result += "  ";
+        index += Math.min(2, content.length - index);
+      } else if (mode === "string" && current === '"') {
+        result += " ";
+        index += 1;
+        mode = "code";
+      } else {
+        result += current === "\n" ? "\n" : " ";
+        index += 1;
+      }
+      continue;
+    }
+    if (current === "/" && next === "/") {
+      result += "  ";
+      index += 2;
+      mode = "line-comment";
+    } else if (current === "/" && next === "*") {
+      result += "  ";
+      index += 2;
+      blockCommentDepth = 1;
+      mode = "block-comment";
+    } else if (triple) {
+      result += "   ";
+      index += 3;
+      mode = "multiline-string";
+    } else if (current === '"') {
+      result += " ";
+      index += 1;
+      mode = "string";
+    } else {
+      result += current;
+      index += 1;
+    }
+  }
+  return result;
+}
