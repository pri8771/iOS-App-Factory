+
+function assertNoExternalGitFilters(repositoryRoot: string): void {
+  const result = invokeGit(
+    repositoryRoot,
+    ["config", "--local", "--includes", "--null", "--name-only", "--get-regexp", "^filter\\."],
+    { allowedStatuses: [0, 1] },
+  );
