+  const mirror = gitWorkspace.prepareImmutableMirror(
+    {
+      sourceRepositoryPath: source,
+      sourceIdentityDigest: `sha256:${"a".repeat(64)}`,
+      runtimeRoot,
+      repositoryId: REPOSITORY_ID,
+      baseCommit: baseSha,
