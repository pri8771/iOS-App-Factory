+let commandCounter = 0;
+function commandId(): string {
+  commandCounter += 1;
+  return `ff000000-0000-4000-8000-${commandCounter.toString().padStart(12, "0")}`;
+}
+
+function startRequest(
+  sourceCommit: string,
