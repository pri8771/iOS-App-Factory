+        attemptId: retriedAttemptId,
+        taskId: failed.taskId,
+        taskSpecDigest: failed.taskSpecDigest,
+        attemptNumber: 2,
+        state: "queued",
+        desiredState: "running",
+        revision: 0,
+        fence: 0,
+        currentStepId: null,
+        blocker: null,
+        outcome: null,
+        createdAt: "2026-08-11T12:00:02.000Z",
+        updatedAt: "2026-08-11T12:00:02.000Z",
+        terminalAt: null,
