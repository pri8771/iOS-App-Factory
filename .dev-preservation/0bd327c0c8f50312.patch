+      throw new Error(`OCI startup run ${intent.runKey} conflicts with its durable task bindings`);
+    }
+    if (intent.fence > attempt.fence) {
+      throw new Error(`OCI startup run ${intent.runKey} claims a future scheduler fence`);
+    }
