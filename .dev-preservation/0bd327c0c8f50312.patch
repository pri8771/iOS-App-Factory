+    schemaVersion: 1,
+    mode: "swift-greeter-codex-v1",
+    fixtureConfigurationFile: normalizedAbsolutePath(
+      record.fixtureConfigurationFile,
+      "fixtureConfigurationFile",
+    ),
+    ...parseCodexAgentIdentityFields(record),
+  };
