+          sourceRepositoryPath: source,
+          moduleName: "TestApp",
+          buildNumber: "1",
+          marketingVersion: "1.0",
+          exportOptions: { ...EXPORT_OPTIONS, teamId: "ZZZZ999999" },
+        },
