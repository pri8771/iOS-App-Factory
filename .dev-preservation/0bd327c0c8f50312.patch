+          source.conclusion,
+          [
+            "SUCCESS",
+            "FAILURE",
+            "NEUTRAL",
+            "CANCELLED",
+            "SKIPPED",
+            "TIMED_OUT",
+            "ACTION_REQUIRED",
+            "STALE",
+          ] as const,
+          "GitHub check conclusion",
+        ).toLowerCase();
