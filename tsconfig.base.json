      "@app-factory/credential-broker": ["./packages/credential-broker/src/index.ts"],
      "@app-factory/evidence-store": ["./packages/evidence-store/src/index.ts"],
      "@app-factory/effect-worker": ["./packages/effect-worker/src/index.ts"],
      "@app-factory/execution-engine": ["./packages/execution-engine/src/index.ts"],
      "@app-factory/git-workspace": ["./packages/git-workspace/src/index.ts"],
      "@app-factory/independent-review": ["./packages/independent-review/src/index.ts"],
      "@app-factory/kernel": ["./packages/kernel/src/index.ts"],
      "@app-factory/learning-engine": ["./packages/learning-engine/src/index.ts"],
      "@app-factory/module-sdk": ["./packages/module-sdk/src/index.ts"],
      "@app-factory/oci-runner": ["./packages/oci-runner/src/index.ts"],
      "@app-factory/ollama-scorer": ["./packages/ollama-scorer/src/index.ts"],
      "@app-factory/policy-corpus": ["./packages/policy-corpus/src/index.ts"],
      "@app-factory/policy-engine": ["./packages/policy-engine/src/index.ts"],
      "@app-factory/portfolio": ["./packages/portfolio/src/index.ts"],
      "@app-factory/project-docs": ["./packages/project-docs/src/index.ts"],
      "@app-factory/provider-http-adapters": ["./packages/provider-http-adapters/src/index.ts"],
      "@app-factory/provider-transport": ["./packages/provider-transport/src/index.ts"],
      "@app-factory/process-supervisor": ["./packages/process-supervisor/src/index.ts"],
      "@app-factory/project-sdk": ["./packages/project-sdk/src/index.ts"],
      "@app-factory/quality": ["./packages/quality/src/index.ts"],
