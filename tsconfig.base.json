{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "useUnknownInCatchVariables": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "paths": {
      "@app-factory/agent-runner": ["./packages/agent-runner/src/index.ts"],
      "@app-factory/command-client": ["./packages/command-client/src/index.ts"],
      "@app-factory/contracts": ["./packages/contracts/src/index.ts"],
      "@app-factory/evidence-store": ["./packages/evidence-store/src/index.ts"],
      "@app-factory/git-workspace": ["./packages/git-workspace/src/index.ts"],
      "@app-factory/independent-review": ["./packages/independent-review/src/index.ts"],
      "@app-factory/kernel": ["./packages/kernel/src/index.ts"],
      "@app-factory/process-supervisor": ["./packages/process-supervisor/src/index.ts"],
      "@app-factory/quality": ["./packages/quality/src/index.ts"],
      "@app-factory/scheduler": ["./packages/scheduler/src/index.ts"],
      "@app-factory/testkit": ["./packages/testkit/src/index.ts"],
      "@app-factory/trusted-verifier": ["./packages/trusted-verifier/src/index.ts"]
    }
  }
}
