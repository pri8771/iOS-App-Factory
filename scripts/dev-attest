#!/usr/bin/env node
// scripts/dev-attest — writes a local owner containment attestation file for Studio/daemon dev.
//
// Every real-identity execution path in apps/daemon (the enrolled Codex profile, live room
// participants when APP_FACTORY_ROOMS_ENABLED=1, planner-codex-v1 execution) refuses to load
// without APP_FACTORY_CONTAINMENT_ATTESTATION pointing at a file
// apps/daemon/src/local-execution-profile.ts's readOwnerContainmentAttestation() accepts. That
// reader requires, byte for byte:
//   - a regular, single-hard-link, current-user-owned file, mode exactly 0600, 1..16384 bytes
//     (readPrivateFile's discipline — see MAX_ATTESTATION_BYTES/PRIVATE_MODE_MASK there);
//   - canonical UTF-8 JSON with no NUL bytes;
//   - a JSON object with EXACTLY these five keys, no more, no fewer:
//       schemaVersion  — literal 1
//       decision       — non-empty text, <=4000 chars, no leading/trailing whitespace
//       acceptedGaps   — 1..32 non-empty strings, each <=1000 chars
//       date           — exact "YYYY-MM-DD" calendar date
//       owner          — non-empty text, <=200 chars
// This script produces exactly that shape so local dev doesn't need to hand-author it. It is a
// dev convenience, not a security review: the "decision"/"acceptedGaps" text says so explicitly.
//
// Usage:
//   scripts/dev-attest [--owner "Full Name"] [path]
//
// `path` defaults to $APP_FACTORY_RUNTIME_DIR/attestation.json. With neither a path argument nor
// APP_FACTORY_RUNTIME_DIR set, this refuses rather than guessing where to write.
//
// See docs/operations/studio-dev-runbook.md for the full local daemon setup this fits into.

import { execFileSync } from "node:child_process";
import { chmodSync, mkdirSync, statSync, writeFileSync } from "node:fs";
import { userInfo } from "node:os";
import { dirname, isAbsolute, resolve } from "node:path";

function fail(message) {
  process.stderr.write(`dev-attest: ${message}\n`);
  process.exit(1);
}

function printUsageAndExit(stream) {
  stream.write(
    'Usage: scripts/dev-attest [--owner "Full Name"] [path]\n' +
      "\n" +
      "  path    Where to write the attestation file. Defaults to\n" +
      "          $APP_FACTORY_RUNTIME_DIR/attestation.json when omitted.\n" +
      "  --owner Attestation owner name. Defaults to `git config user.name`,\n" +
      "          then the OS account name.\n",
  );
  process.exit(stream === process.stderr ? 1 : 0);
}

function parseArgs(argv) {
  let owner;
  const positional = [];
  for (let index = 0; index < argv.length; index += 1) {
    const arg = argv[index];
    if (arg === "--help" || arg === "-h") {
      printUsageAndExit(process.stdout);
    } else if (arg === "--owner") {
      owner = argv[index + 1];
      index += 1;
      if (owner === undefined) fail("--owner requires a value.");
    } else if (arg.startsWith("--owner=")) {
      owner = arg.slice("--owner=".length);
    } else if (arg.startsWith("-")) {
      fail(`Unrecognized flag: ${arg}. Run with --help for usage.`);
    } else {
      positional.push(arg);
    }
  }
  if (positional.length > 1) {
    fail("Expected at most one positional argument (the output path). Run with --help for usage.");
  }
  return { owner, path: positional[0] };
}

function defaultOwner() {
  try {
    const name = execFileSync("git", ["config", "--get", "user.name"], {
      encoding: "utf8",
      stdio: ["ignore", "pipe", "ignore"],
    }).trim();
    if (name.length > 0) return name;
  } catch {
    // No git config user.name (or git unavailable) — fall through to the OS account name.
  }
  try {
    const name = userInfo().username;
    if (name.length > 0) return name;
  } catch {
    // userInfo() can throw on some platforms/sandboxes.
  }
  return "local-dev-owner";
}

function todayIsoDate() {
  return new Date().toISOString().slice(0, 10);
}

function resolveTargetPath(pathArg) {
  if (pathArg !== undefined) {
    if (!isAbsolute(pathArg)) fail(`Output path must be absolute: ${pathArg}`);
    return resolve(pathArg);
  }
  const runtimeDir = process.env.APP_FACTORY_RUNTIME_DIR;
  if (runtimeDir === undefined || runtimeDir.length === 0) {
    fail(
      "No output path given and APP_FACTORY_RUNTIME_DIR is not set. Either export " +
        "APP_FACTORY_RUNTIME_DIR or pass a path explicitly: scripts/dev-attest /path/to/attestation.json",
    );
  }
  if (!isAbsolute(runtimeDir)) {
    fail(`APP_FACTORY_RUNTIME_DIR must be an absolute path, got: ${runtimeDir}`);
  }
  return resolve(runtimeDir, "attestation.json");
}

const { owner: ownerFlag, path: pathArg } = parseArgs(process.argv.slice(2));
const targetPath = resolveTargetPath(pathArg);
const owner = ownerFlag ?? defaultOwner();
const date = todayIsoDate();

const attestation = {
  schemaVersion: 1,
  decision:
    "Local development attestation generated by scripts/dev-attest, so the app-factory daemon's " +
    "real-identity execution paths (the enrolled coding-agent profile, live room participants under " +
    "APP_FACTORY_ROOMS_ENABLED, planner-codex-v1 execution) can load on the owner's own development " +
    "machine, under the owner's own account. This is a local dev convenience, not a production " +
    "containment review — see docs/operations/studio-dev-runbook.md.",
  acceptedGaps: [
    "No third-party network exposure or sandbox review has been performed for this machine.",
    "Generated automatically by scripts/dev-attest; not backed by a human security decision.",
  ],
  date,
  owner,
};

mkdirSync(dirname(targetPath), { recursive: true });
writeFileSync(targetPath, `${JSON.stringify(attestation, null, 2)}\n`, { mode: 0o600 });
// writeFileSync only applies `mode` when it creates the file; chmod explicitly so a rerun over an
// existing (possibly differently-permissioned) file still ends up at exactly 0600.
chmodSync(targetPath, 0o600);

const mode = (statSync(targetPath).mode & 0o777).toString(8);
process.stdout.write(
  `dev-attest: wrote ${targetPath} (mode ${mode}, owner "${owner}", date ${date})\n` +
    `dev-attest: export APP_FACTORY_CONTAINMENT_ATTESTATION="${targetPath}"\n`,
);
