    {
      "field": "rules[].appliesTo",
      "branch": "studio/policy-engine-scoping",
      "note": "Phase scoping is carried here as free-form stage names from mission-control gates.md (idea, building, qa, launch-prep, live); the engine schema has no such field yet."
    },
    {
      "field": "rules[].humanOnly",
      "branch": "studio/policy-engine-scoping",
      "note": "Human-only owner flag for gate:legal, gate:device, gate:store, gate:market, credentialed actions, and architecture decisions."
    },
