  "protectedSurfaceNotes": [
    {
      "path": ".factory/**",
      "note": "Legacy 0.2.0 authority layout, and the layout upstream 0.4.0 still bootstraps (.factory/project-context.json, standard-lock.json, AGENTS.factory.md, plus 0.4.0's repository-map.json and library-catalog.json; the 0.4.0 factory CLI additionally writes .factory/project-context.yaml, current-state.yaml, scope-lock.yaml, agent-policy.yaml, runs/). Protected so a parallel legacy layout cannot be reintroduced silently after migration to .app-factory/ (Hindsight factory/pilot-1.1 archived it under .app-factory/legacy/). The compiler does not emit any .factory/ artifact; see RULES_CORPUS_RECONCILIATION.md §2."
    },
    {
      "path": ".app-factory/**",
      "note": "Current project/experience manifests and archived legacy content."
    },
    {
      "path": "*UITests/**",
      "note": "Glob covers HindsightUITests/**; the engine schema stores the string verbatim and does not interpret globs yet."
    },
    {
      "path": "**/*.entitlements",
      "note": "Signing surface; glob semantics are a broker concern, not the schema's."
    },
    {
      "path": "**/ExportOptions.plist",
      "note": "Signing/export surface."
    },
    {
      "path": "docs/RELEASE_CHECKLIST.md",
      "note": "Hindsight keeps this file at Docs/RELEASE_CHECKLIST.md (capital D); a per-project override or case-insensitive surface match is needed before the compiled lock can protect it there."
    }
  ],
  "todos": [
    {
      "field": "rules[].appliesTo",
      "branch": "studio/policy-engine-scoping",
      "note": "Phase scoping is carried here as free-form stage names from mission-control gates.md (idea, building, qa, launch-prep, live); the engine schema has no such field yet."
    },
    {
      "field": "rules[].humanOnly",
      "branch": "studio/policy-engine-scoping",
      "note": "Human-only owner flag for gate:legal, gate:device, gate:store, gate:market, credentialed actions, and architecture decisions."
    },
    {
      "field": "checkRegistry",
      "branch": "studio/policy-engine-scoping",
      "note": "requiredCheck codes are free-form NamespacedCode strings today; a registry mapping code to executor and status is needed so the broker can fail closed on unknown checks."
    },
    {
      "field": "protectedSurfaces[].path glob semantics",
      "branch": "studio/policy-engine-scoping",
      "note": "The engine stores surface paths verbatim; whether **, *, and case-insensitivity are honored is undefined until the broker's matcher is specified."
    },
    {
      "field": "project-local preamble",
      "branch": "studio/policy-engine-scoping",
      "note": "The compiled AGENTS.md replaces the whole file, so Hindsight's project-specific reading order (.app-factory/project.json, quality/quality-manifest.json, Docs/*) has no home in the compiled authority; it belongs in the project manifest or a nested AGENTS.md scope."
    },
    {
      "field": "source.corpus provenance",
      "branch": "studio/policy-engine-scoping",
      "note": "The engine's integer policyVersion (now 2) is unrelated to the corpus semver (0.4.0 @ 4b8b12e); the corpus version, commit, and file digests live only in this sidecar."
    },
    {
      "field": "0.4.0 navigation artifacts",
      "branch": "studio/policy-engine-scoping",
      "note": "Upstream 0.4.0 requires .factory/repository-map.json (schemaVersion 1.0.0), .factory/library-catalog.json (catalogVersion 0.1.0), docs/README.md, and docs/REUSABLE_COMPONENTS.md in every registered product and locks repositoryMapVersion/libraryCatalogVersion in .factory/standard-lock.json. This repository's scanner treats .factory/ as the legacy layout and enrolls through .app-factory/ manifests, so the compiler does not emit them; whether an .app-factory/ equivalent (repository map, library catalog) is added, and which side owns docs/README.md, is an open decision recorded in RULES_CORPUS_RECONCILIATION.md §6."
    },
    {
      "field": "copilot adapter",
      "branch": "studio/policy-engine-scoping",
      "note": "The corpus lists .github/copilot-instructions.md as a supported entry point. PolicyClientV1 and ProjectManifestV1.rules.clientEntrypoints.client now include copilot and CanonicalPolicySourceV1.clients is optional, but this compiled source still declares no clients (legacy default claude/cursor/antigravity), so the bundle set is unchanged and an existing copilot adapter stays bound to the pre-bundle AGENTS.md digest (rules.adapter-nonconforming + rules.conflicting-declaration until repair-rule-adapter rebinds it). Adding copilot to clients is a bundle-set decision, not corpus drift; see RULES_CORPUS_RECONCILIATION.md §6 item 1."
    }
  ]
}
