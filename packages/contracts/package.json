{
  "name": "@app-factory/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./v1": {
      "types": "./dist/v1/index.d.ts",
      "import": "./dist/v1/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b --pretty false",
    "clean": "tsc -b --clean",
    "schemas:generate": "pnpm build && node scripts/generate-json-schemas.mjs",
    "schemas:check": "pnpm build && node scripts/generate-json-schemas.mjs --check"
  },
  "dependencies": {
    "zod": "4.4.3"
  }
}
