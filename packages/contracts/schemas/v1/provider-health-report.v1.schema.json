{
  "$id": "urn:app-factory:contracts:v1:provider-health-report",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "detail": {
      "anyOf": [
        {
          "maxLength": 1000,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "latencyMs": {
      "anyOf": [
        {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "enum": [
        "ok",
        "unreachable",
        "unauthenticated",
        "not-configured",
        "blocked"
      ],
      "type": "string"
    },
    "version": {
      "anyOf": [
        {
          "maxLength": 100,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "status",
    "detail",
    "latencyMs",
    "version"
  ],
  "type": "object"
}
