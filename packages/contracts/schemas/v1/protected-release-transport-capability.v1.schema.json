{
  "$id": "urn:app-factory:contracts:v1:protected-release-transport-capability",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "available": {
      "type": "boolean"
    },
    "blockerCode": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z][a-z0-9]*)+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "checkedAt": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$",
      "type": "string"
    },
    "enabledByDefault": {
      "type": "boolean"
    },
    "schemaVersion": {
      "const": 1,
      "type": "number"
    },
    "summary": {
      "maxLength": 1000,
      "minLength": 1,
      "type": "string"
    },
    "transportProtocol": {
      "enum": [
        "app-factory.fake-apple-upload.v1",
        "app-factory.apple-upload.v1"
      ],
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "transportProtocol",
    "available",
    "enabledByDefault",
    "blockerCode",
    "summary",
    "checkedAt"
  ],
  "type": "object"
}
