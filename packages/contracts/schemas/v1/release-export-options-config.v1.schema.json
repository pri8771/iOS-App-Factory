{
  "$id": "urn:app-factory:contracts:v1:release-export-options-config",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "bundleIdOverride": {
      "anyOf": [
        {
          "maxLength": 255,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9-]+(?:\\.[A-Za-z0-9-]+)+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "destination": {
      "enum": [
        "upload",
        "export"
      ],
      "type": "string"
    },
    "method": {
      "const": "app-store-connect",
      "type": "string"
    },
    "schemaVersion": {
      "const": 1,
      "type": "number"
    },
    "signingStyle": {
      "const": "automatic",
      "type": "string"
    },
    "teamId": {
      "pattern": "^[A-Z0-9]{10}$",
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "teamId",
    "method",
    "destination",
    "signingStyle",
    "bundleIdOverride"
  ],
  "type": "object"
}
