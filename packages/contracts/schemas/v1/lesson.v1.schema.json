      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$",
      "type": "string"
    },
    "__schema2": {
      "maxLength": 300,
      "minLength": 1,
      "type": "string"
    },
    "__schema3": {
      "items": {
        "$ref": "#/$defs/__schema1"
      },
      "maxItems": 1000,
      "minItems": 1,
      "type": "array"
    },
    "__schema4": {
      "maxLength": 10000,
      "minLength": 1,
      "type": "string"
    },
    "__schema5": {
      "maxLength": 10000,
      "minLength": 1,
      "type": "string"
    },
    "__schema6": {
      "enum": [
        "project",
        "template",
        "all-projects",
        "module"
      ],
      "type": "string"
    },
    "__schema7": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "__schema8": {
      "anyOf": [
        {
          "$ref": "#/$defs/__schema7"
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema9": {
      "enum": [
        "proposed",
        "approved",
        "adopted",
        "rejected"
      ],
      "type": "string"
    }
  },
