{
  "$defs": {
    "__schema0": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "__schema1": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "__schema2": {
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
      "type": "string"
    },
    "__schema3": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "$ref": "#/$defs/__schema1"
        },
        "evidenceId": {
          "$ref": "#/$defs/__schema0"
        }
      },
      "required": [
        "evidenceId",
        "digest"
      ],
      "type": "object"
    },
    "__schema4": {
      "enum": [
        "agent-run",
        "verification",
        "review",
        "commit",
        "event-log"
      ],
      "type": "string"
    }
  },
  "$id": "urn:app-factory:contracts:v1:evidence-manifest",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attemptId": {
      "$ref": "#/$defs/__schema0"
    },
    "createdAt": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$",
      "type": "string"
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/__schema3"
      },
      "maxItems": 1000,
      "minItems": 1,
      "type": "array"
    },
    "requiredKinds": {
      "items": {
        "$ref": "#/$defs/__schema4"
      },
      "maxItems": 5,
      "minItems": 1,
      "type": "array"
    },
    "schemaVersion": {
      "const": 1,
      "type": "number"
    },
    "subject": {
      "additionalProperties": false,
      "properties": {
        "baseCommit": {
          "$ref": "#/$defs/__schema2"
        },
        "candidateTree": {
          "anyOf": [
            {
              "$ref": "#/$defs/__schema2"
            },
            {
              "type": "null"
            }
          ]
        },
        "fence": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "policyDigest": {
          "$ref": "#/$defs/__schema1"
        },
        "taskSpecDigest": {
          "$ref": "#/$defs/__schema1"
        }
      },
      "required": [
        "taskSpecDigest",
        "policyDigest",
        "baseCommit",
        "candidateTree",
        "fence"
      ],
      "type": "object"
    }
  },
  "required": [
    "schemaVersion",
    "attemptId",
    "createdAt",
    "subject",
    "entries",
    "requiredKinds"
  ],
  "type": "object"
}
