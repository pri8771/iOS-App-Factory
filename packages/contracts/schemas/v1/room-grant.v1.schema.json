{
  "$defs": {
    "__schema0": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    },
    "__schema1": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "__schema2": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$",
      "type": "string"
    }
  },
  "$id": "urn:app-factory:contracts:v1:room-grant",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "createdAt": {
      "$ref": "#/$defs/__schema2"
    },
    "grantId": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "headSequence": {
      "$ref": "#/$defs/__schema1"
    },
    "leaseExpiresAt": {
      "$ref": "#/$defs/__schema2"
    },
    "outcome": {
      "anyOf": [
        {
          "oneOf": [
            {
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "committed",
                  "type": "string"
                },
                "messageSequence": {
                  "$ref": "#/$defs/__schema0"
                },
                "revalidated": {
                  "type": "boolean"
                },
                "tokensUsed": {
                  "$ref": "#/$defs/__schema1"
                }
              },
              "required": [
                "kind",
                "messageSequence",
                "tokensUsed",
                "revalidated"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "passed",
                  "type": "string"
                },
                "tokensUsed": {
                  "$ref": "#/$defs/__schema1"
                }
              },
              "required": [
                "kind",
                "tokensUsed"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "benchedUntil": {
                  "$ref": "#/$defs/__schema2"
                },
                "code": {
                  "enum": [
                    "limit",
                    "timeout",
                    "capacity",
                    "internal"
                  ],
                  "type": "string"
                },
                "kind": {
                  "const": "failed",
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "code",
                "benchedUntil"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "dropped",
                  "type": "string"
                },
                "reason": {
                  "enum": [
                    "revalidation-dropped",
                    "revalidation-exhausted"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "reason"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "orphaned",
                  "type": "string"
                },
                "workerKilled": {
                  "type": "boolean"
                }
              },
              "required": [
                "kind",
                "workerKilled"
              ],
              "type": "object"
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "ownerPid": {
      "$ref": "#/$defs/__schema0"
    },
    "persona": {
      "pattern": "^[a-z][a-z0-9-]{0,63}$",
      "type": "string"
    },
    "reservedTokens": {
      "$ref": "#/$defs/__schema0"
    },
    "roomId": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "roundNumber": {
      "$ref": "#/$defs/__schema0"
    },
    "schemaVersion": {
      "const": 1,
      "type": "number"
    },
    "state": {
      "enum": [
        "active",
        "held",
        "committed",
        "passed",
        "failed",
        "dropped",
        "orphaned"
      ],
      "type": "string"
    },
    "updatedAt": {
      "$ref": "#/$defs/__schema2"
    },
    "workerPid": {
      "anyOf": [
        {
          "$ref": "#/$defs/__schema0"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schemaVersion",
    "grantId",
    "roomId",
    "roundNumber",
    "persona",
    "headSequence",
    "state",
    "ownerPid",
    "workerPid",
    "reservedTokens",
    "leaseExpiresAt",
    "createdAt",
    "updatedAt",
    "outcome"
  ],
  "type": "object"
}
