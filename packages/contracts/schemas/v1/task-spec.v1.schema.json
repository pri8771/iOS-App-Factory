{
  "$defs": {
    "__schema0": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "__schema1": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9-]{0,63}$",
          "type": "string"
        },
        "statement": {
          "maxLength": 2000,
          "minLength": 1,
          "type": "string"
        },
        "verification": {
          "enum": [
            "automated",
            "review",
            "operator"
          ],
          "type": "string"
        }
      },
      "required": [
        "id",
        "statement",
        "verification"
      ],
      "type": "object"
    },
    "__schema2": {
      "maxLength": 1024,
      "minLength": 1,
      "pattern": "^(?!\\/)(?!\\.{1,2}(?:\\/|$))(?!.*\\/\\.{1,2}(?:\\/|$))(?!.*\\/\\/)(?!.*\\/$)(?!.*\\\\)(?!.*\\0).+$",
      "type": "string"
    }
  },
  "$id": "urn:app-factory:contracts:v1:task-spec",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "acceptanceCriteria": {
      "items": {
        "$ref": "#/$defs/__schema1"
      },
      "maxItems": 50,
      "minItems": 1,
      "type": "array"
    },
    "base": {
      "additionalProperties": false,
      "properties": {
        "commit": {
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
          "type": "string"
        },
        "repositoryId": {
          "$ref": "#/$defs/__schema0"
        }
      },
      "required": [
        "repositoryId",
        "commit"
      ],
      "type": "object"
    },
    "createdAt": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$",
      "type": "string"
    },
    "objective": {
      "maxLength": 20000,
      "minLength": 1,
      "type": "string"
    },
    "policyDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "projectId": {
      "$ref": "#/$defs/__schema0"
    },
    "requestedScope": {
      "additionalProperties": false,
      "properties": {
        "paths": {
          "items": {
            "$ref": "#/$defs/__schema2"
          },
          "maxItems": 100,
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "paths"
      ],
      "type": "object"
    },
    "schemaVersion": {
      "const": 1,
      "type": "number"
    },
    "taskId": {
      "$ref": "#/$defs/__schema0"
    },
    "title": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "taskId",
    "projectId",
    "createdAt",
    "title",
    "objective",
    "acceptanceCriteria",
    "base",
    "requestedScope",
    "policyDigest"
  ],
  "type": "object"
}
