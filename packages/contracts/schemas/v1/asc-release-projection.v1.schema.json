{
  "$defs": {
    "__schema0": {
      "const": 1,
      "type": "number"
    },
    "__schema1": {
      "additionalProperties": false,
      "properties": {
        "appId": {
          "$ref": "#/$defs/__schema2"
        },
        "bundleId": {
          "maxLength": 255,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9-]+(?:\\.[A-Za-z0-9-]+)+$",
          "type": "string"
        },
        "name": {
          "maxLength": 500,
          "minLength": 1,
          "type": "string"
        },
        "primaryLocale": {
          "anyOf": [
            {
              "maxLength": 50,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "schemaVersion": {
          "$ref": "#/$defs/__schema0"
        },
        "sku": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schemaVersion",
        "appId",
        "bundleId",
        "name",
        "sku",
        "primaryLocale"
      ],
      "type": "object"
    },
    "__schema10": {
      "anyOf": [
        {
          "$ref": "#/$defs/__schema4"
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema2": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "type": "string"
    },
    "__schema3": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "appId": {
              "$ref": "#/$defs/__schema2"
            },
            "buildId": {
              "$ref": "#/$defs/__schema2"
            },
            "buildNumber": {
              "maxLength": 100,
              "minLength": 1,
              "type": "string"
            },
            "expired": {
              "type": "boolean"
            },
            "externalBuildState": {
              "anyOf": [
                {
                  "$ref": "#/$defs/__schema5"
                },
                {
                  "type": "null"
                }
              ]
            },
            "internalBuildState": {
              "anyOf": [
                {
                  "$ref": "#/$defs/__schema5"
                },
                {
                  "type": "null"
                }
              ]
            },
            "marketingVersion": {
              "anyOf": [
                {
                  "maxLength": 100,
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "processingState": {
              "enum": [
                "PROCESSING",
                "FAILED",
                "INVALID",
                "VALID"
              ],
              "type": "string"
            },
            "schemaVersion": {
              "$ref": "#/$defs/__schema0"
            },
            "uploadedDate": {
              "anyOf": [
                {
                  "$ref": "#/$defs/__schema4"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "schemaVersion",
            "buildId",
            "appId",
            "buildNumber",
            "marketingVersion",
            "uploadedDate",
            "processingState",
            "expired",
            "internalBuildState",
            "externalBuildState"
          ],
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema4": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$",
      "type": "string"
    },
    "__schema5": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Z][A-Z0-9_]*$",
      "type": "string"
    },
    "__schema6": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "appId": {
              "$ref": "#/$defs/__schema2"
            },
            "appStoreState": {
              "anyOf": [
                {
                  "$ref": "#/$defs/__schema5"
                },
                {
                  "type": "null"
                }
              ]
            },
            "appStoreVersionId": {
              "$ref": "#/$defs/__schema2"
            },
            "appVersionState": {
              "anyOf": [
                {
                  "$ref": "#/$defs/__schema5"
                },
                {
                  "type": "null"
                }
              ]
            },
            "createdDate": {
              "anyOf": [
                {
                  "$ref": "#/$defs/__schema4"
                },
                {
                  "type": "null"
                }
              ]
            },
            "platform": {
              "$ref": "#/$defs/__schema5"
            },
            "schemaVersion": {
              "$ref": "#/$defs/__schema0"
            },
            "versionString": {
              "maxLength": 100,
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "schemaVersion",
            "appStoreVersionId",
            "appId",
            "versionString",
            "platform",
            "appStoreState",
            "appVersionState",
            "createdDate"
          ],
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema7": {
      "anyOf": [
        {
          "enum": [
            "candidate",
            "certified",
            "archived",
            "upload-approved",
            "uploaded",
            "processing",
            "internal-testflight-available",
            "device-smoke-passed"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema8": {
      "enum": [
        "no-build-observed",
        "build-processing",
        "build-processing-failed",
        "build-processed-not-in-internal-testing",
        "build-in-internal-testing",
        "build-expired"
      ],
      "type": "string"
    },
    "__schema9": {
      "anyOf": [
        {
          "$ref": "#/$defs/__schema4"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$id": "urn:app-factory:contracts:v1:asc-release-projection",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "app": {
      "$ref": "#/$defs/__schema1"
    },
    "internalTestFlightAvailableAt": {
      "$ref": "#/$defs/__schema10"
    },
    "latestAppStoreVersion": {
      "$ref": "#/$defs/__schema6"
    },
    "latestBuild": {
      "$ref": "#/$defs/__schema3"
    },
    "observedAt": {
      "$ref": "#/$defs/__schema4"
    },
    "projectedStage": {
      "$ref": "#/$defs/__schema7"
    },
    "projectionBasis": {
      "$ref": "#/$defs/__schema8"
    },
    "schemaVersion": {
      "$ref": "#/$defs/__schema0"
    },
    "uploadedAt": {
      "$ref": "#/$defs/__schema9"
    }
  },
  "required": [
    "schemaVersion",
    "app",
    "latestBuild",
    "latestAppStoreVersion",
    "projectedStage",
    "projectionBasis",
    "uploadedAt",
    "internalTestFlightAvailableAt",
    "observedAt"
  ],
  "type": "object"
}
