{
  "$defs": {
    "__schema0": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "__schema1": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "$id": "urn:app-factory:contracts:v1:lifecycle-event",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "causationEventId": {
      "anyOf": [
        {
          "$ref": "#/$defs/__schema0"
        },
        {
          "type": "null"
        }
      ]
    },
    "emittedAt": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$",
      "type": "string"
    },
    "eventId": {
      "$ref": "#/$defs/__schema0"
    },
    "evidenceDigest": {
      "$ref": "#/$defs/__schema1"
    },
    "operationKey": {
      "maxLength": 500,
      "minLength": 16,
      "pattern": "^app-factory:v1:[a-z0-9][a-z0-9:._-]+$",
      "type": "string"
    },
    "payloadDigest": {
      "$ref": "#/$defs/__schema1"
    },
    "policyDigest": {
      "$ref": "#/$defs/__schema1"
    },
    "projectId": {
      "$ref": "#/$defs/__schema0"
    },
    "releaseId": {
      "anyOf": [
        {
          "$ref": "#/$defs/__schema0"
        },
        {
          "type": "null"
        }
      ]
    },
    "schemaVersion": {
      "const": 1,
      "type": "number"
    },
    "type": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z][a-z0-9]*)+$",
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "eventId",
    "type",
    "projectId",
    "releaseId",
    "operationKey",
    "payloadDigest",
    "policyDigest",
    "evidenceDigest",
    "causationEventId",
    "emittedAt"
  ],
  "type": "object"
}
