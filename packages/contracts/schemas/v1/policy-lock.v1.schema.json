{
  "$defs": {
    "__schema0": {
      "const": 1,
      "type": "number"
    },
    "__schema1": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z][a-z0-9]*)+$",
      "type": "string"
    },
    "__schema10": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$",
      "type": "string"
    },
    "__schema2": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    },
    "__schema3": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "__schema4": {
      "items": {
        "$ref": "#/$defs/__schema5"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array"
    },
    "__schema5": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "$ref": "#/$defs/__schema3"
        },
        "path": {
          "$ref": "#/$defs/__schema6"
        }
      },
      "required": [
        "path",
        "digest"
      ],
      "type": "object"
    },
    "__schema6": {
      "maxLength": 1024,
      "minLength": 1,
      "pattern": "^(?!\\/)(?!\\.{1,2}(?:\\/|$))(?!.*\\/\\.{1,2}(?:\\/|$))(?!.*\\/\\/)(?!.*\\/$)(?!.*\\\\)(?!.*\\0).+$",
      "type": "string"
    },
    "__schema7": {
      "items": {
        "$ref": "#/$defs/__schema8"
      },
      "maxItems": 1000,
      "minItems": 1,
      "type": "array"
    },
    "__schema8": {
      "additionalProperties": false,
      "properties": {
        "changeApprovalAction": {
          "$ref": "#/$defs/__schema1"
        },
        "classification": {
          "enum": [
            "policy",
            "ci",
            "test-harness",
            "baseline",
            "quality-threshold",
            "signing",
            "release"
          ],
          "type": "string"
        },
        "path": {
          "$ref": "#/$defs/__schema6"
        }
      },
      "required": [
        "path",
        "classification",
        "changeApprovalAction"
      ],
      "type": "object"
    },
    "__schema9": {
      "items": {
        "$ref": "#/$defs/__schema1"
      },
      "maxItems": 200,
      "minItems": 1,
      "type": "array"
    }
  },
  "$id": "urn:app-factory:contracts:v1:policy-lock",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authorityFiles": {
      "$ref": "#/$defs/__schema4"
    },
    "generatedAt": {
      "$ref": "#/$defs/__schema10"
    },
    "policyDigest": {
      "$ref": "#/$defs/__schema3"
    },
    "policyId": {
      "$ref": "#/$defs/__schema1"
    },
    "policyVersion": {
      "$ref": "#/$defs/__schema2"
    },
    "protectedSurfaces": {
      "$ref": "#/$defs/__schema7"
    },
    "requiredChecks": {
      "$ref": "#/$defs/__schema9"
    },
    "schemaVersion": {
      "$ref": "#/$defs/__schema0"
    }
  },
  "required": [
    "schemaVersion",
    "policyId",
    "policyVersion",
    "policyDigest",
    "authorityFiles",
    "protectedSurfaces",
    "requiredChecks",
    "generatedAt"
  ],
  "type": "object"
}
