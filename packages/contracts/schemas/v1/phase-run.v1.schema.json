    "__schema31": {
      "anyOf": [
        {
          "maximum": 1440,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema32": {
      "maximum": 86400,
      "minimum": 1,
      "type": "integer"
    },
    "__schema33": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "__schema34": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$",
      "type": "string"
    },
    "__schema35": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "$ref": "#/$defs/__schema3"
        },
        "evidence": {
          "additionalProperties": false,
          "properties": {
            "branch": {
              "maxLength": 255,
              "minLength": 1,
