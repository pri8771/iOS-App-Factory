  "$id": "urn:app-factory:contracts:v1:phase-run",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "createdAt": {
      "$ref": "#/$defs/__schema34"
    },
    "finishedAt": {
      "anyOf": [
        {
          "$ref": "#/$defs/__schema34"
        },
        {
          "type": "null"
        }
      ]
    },
    "graderVerdict": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "findings": {
              "items": {
                "$ref": "#/$defs/__schema37"
              },
              "maxItems": 50,
              "type": "array"
            },
            "verdict": {
              "enum": [
                "pass",
                "changes-required"
              ],
              "type": "string"
            }
          },
          "required": [
            "verdict",
            "findings"
          ],
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "outcome": {
      "anyOf": [
        {
          "oneOf": [
            {
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "succeeded",
                  "type": "string"
                }
              },
              "required": [
                "kind"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "code": {
                  "enum": [
                    "participant-error",
                    "grader-changes-required",
                    "output-schema-invalid",
                    "output-commit-rejected",
                    "rejected"
                  ],
                  "type": "string"
                },
                "kind": {
                  "const": "failed",
                  "type": "string"
                },
                "summary": {
                  "maxLength": 2000,
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "code",
                "summary"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "cancelled",
                  "type": "string"
                },
                "reason": {
                  "maxLength": 1000,
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "reason"
              ],
              "type": "object"
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "outputs": {
      "items": {
        "$ref": "#/$defs/__schema35"
      },
      "maxItems": 10,
      "type": "array"
    },
    "phaseId": {
      "$ref": "#/$defs/__schema2"
    },
    "phaseRunId": {
      "$ref": "#/$defs/__schema1"
    },
    "phaseSnapshot": {
      "additionalProperties": false,
      "properties": {
        "budget": {
          "$ref": "#/$defs/__schema30"
        },
        "cast": {
          "$ref": "#/$defs/__schema7"
        },
        "createdAt": {
          "$ref": "#/$defs/__schema34"
        },
        "gates": {
          "$ref": "#/$defs/__schema28"
        },
        "inputs": {
          "$ref": "#/$defs/__schema15"
        },
        "mode": {
          "$ref": "#/$defs/__schema6"
        },
        "name": {
          "$ref": "#/$defs/__schema4"
        },
        "outputs": {
          "$ref": "#/$defs/__schema26"
        },
        "phaseId": {
          "$ref": "#/$defs/__schema2"
        },
        "purpose": {
          "$ref": "#/$defs/__schema5"
        },
        "revision": {
          "$ref": "#/$defs/__schema33"
        },
        "rules": {
          "$ref": "#/$defs/__schema17"
        },
        "schemaVersion": {
          "$ref": "#/$defs/__schema0"
        },
        "updatedAt": {
          "$ref": "#/$defs/__schema34"
        }
      },
      "required": [
        "schemaVersion",
        "phaseId",
        "name",
        "purpose",
        "mode",
        "cast",
        "inputs",
        "rules",
        "outputs",
        "gates",
        "budget",
        "revision",
        "createdAt",
        "updatedAt"
      ],
      "type": "object"
    },
    "phaseSnapshotDigest": {
      "$ref": "#/$defs/__schema3"
    },
    "presetId": {
      "anyOf": [
        {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9-]{0,63}(?:\\.[a-z0-9]{1,16}){0,6}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "projectId": {
      "$ref": "#/$defs/__schema1"
    },
    "revision": {
      "$ref": "#/$defs/__schema33"
    },
    "roomId": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "schemaVersion": {
      "$ref": "#/$defs/__schema0"
    },
    "startedAt": {
      "anyOf": [
        {
          "$ref": "#/$defs/__schema34"
        },
        {
          "type": "null"
        }
      ]
    },
    "state": {
      "enum": [
        "queued",
        "running",
        "awaiting-human",
        "succeeded",
        "failed",
        "cancelled"
      ],
      "type": "string"
    },
    "tokenUsage": {
      "additionalProperties": false,
      "properties": {
        "totalTokens": {
          "$ref": "#/$defs/__schema33"
        }
      },
      "required": [
        "totalTokens"
      ],
      "type": "object"
    },
    "updatedAt": {
      "$ref": "#/$defs/__schema34"
    }
  },
  "required": [
    "schemaVersion",
    "phaseRunId",
    "presetId",
    "phaseId",
    "projectId",
    "phaseSnapshotDigest",
    "phaseSnapshot",
    "state",
    "revision",
    "roomId",
    "outputs",
    "graderVerdict",
    "tokenUsage",
    "outcome",
    "createdAt",
    "startedAt",
    "finishedAt",
    "updatedAt"
  ],
  "type": "object"
}
