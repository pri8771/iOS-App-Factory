{
  "$defs": {
    "__schema0": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "__schema1": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "$id": "urn:app-factory:contracts:v1:sanitized-release-transport-receipt",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "detailDigest": {
      "anyOf": [
        {
          "$ref": "#/$defs/__schema1"
        },
        {
          "type": "null"
        }
      ]
    },
    "effectId": {
      "$ref": "#/$defs/__schema0"
    },
    "identityDigest": {
      "$ref": "#/$defs/__schema1"
    },
    "outcome": {
      "enum": [
        "accepted",
        "rejected",
        "timeout-uncertain",
        "identity-mismatch",
        "duplicate-provider-receipt",
        "malformed-receipt"
      ],
      "type": "string"
    },
    "providerBuildId": {
      "anyOf": [
        {
          "maxLength": 500,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "providerCorrelationKey": {
      "anyOf": [
        {
          "maxLength": 1000,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "reasonCode": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z][a-z0-9]*)+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "recordedAt": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$",
      "type": "string"
    },
    "releaseRunId": {
      "$ref": "#/$defs/__schema0"
    },
    "schemaVersion": {
      "const": 1,
      "type": "number"
    },
    "transportProtocol": {
      "enum": [
        "app-factory.fake-apple-upload.v1",
        "app-factory.apple-upload.v1"
      ],
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "effectId",
    "releaseRunId",
    "identityDigest",
    "transportProtocol",
    "outcome",
    "providerCorrelationKey",
    "providerBuildId",
    "reasonCode",
    "recordedAt",
    "detailDigest"
  ],
  "type": "object"
}
